{
  "manifest_version": 3,
  "name": "DealDig",
  "version": "0.1.0",
  "description": "Checks online listings, chats and deals for scams before money changes hands.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Open DealDig",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "permissions": ["sidePanel", "storage", "tabs"],
  "host_permissions": ["https://poshmark.com/*", "http://localhost:8787/*"],
  "content_scripts": [
    {
      "matches": [
        "https://poshmark.com/*",
        "https://www.ebay.com/itm/*",
        "https://www.ebay.com/mesg/*",
        "https://mesg.ebay.com/*",
        "https://www.facebook.com/*",
        "https://www.etsy.com/messages/*",
        "https://www.depop.com/messages/*",
        "https://www.mercari.com/*",
        "http://localhost:8787/demo/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
