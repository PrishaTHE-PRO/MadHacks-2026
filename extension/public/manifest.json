{
  "manifest_version": 3,
  "name": "Second Look",
  "version": "0.1.0",
  "description": "Checks online listings, chats and deals for scams before money changes hands.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Open Second Look",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "permissions": ["sidePanel", "storage", "tabs", "webNavigation", "declarativeNetRequest", "declarativeNetRequestFeedback", "contextMenus"],
  "optional_permissions": ["history", "browsingData"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": [
    "https://poshmark.com/*",
    "http://localhost:8787/*",
    "https://di2ponv0v5otw.cloudfront.net/*",
    "https://i.ebayimg.com/*",
    "https://*.fbcdn.net/*",
    "https://*.ebay.com/*",
    "https://*.facebook.com/*",
    "https://*.mercari.com/*",
    "https://*.etsy.com/*",
    "https://*.depop.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "trackers", "enabled": true, "path": "rules/trackers.json" },
      { "id": "strict", "enabled": false, "path": "rules/strict.json" },
      { "id": "clean", "enabled": true, "path": "rules/clean-urls.json" }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://poshmark.com/*",
        "https://www.ebay.com/itm/*",
        "https://www.ebay.com/sl/*",
        "https://www.ebay.com/lstng*",
        "https://www.ebay.com/mesg/*",
        "https://mesg.ebay.com/*",
        "https://www.facebook.com/*",
        "https://www.etsy.com/messages/*",
        "https://www.depop.com/messages/*",
        "https://www.mercari.com/*",
        "http://localhost:8787/demo/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
