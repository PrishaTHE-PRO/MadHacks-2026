# Copy to server/.env and fill in. Everything is optional: without keys the
# server still scores listings with rules only.

# Claude: item identification, price estimate, red flags, one-line explanation.
ANTHROPIC_API_KEY=

# eBay Browse API (free keys at developer.ebay.com): live price comparisons.
# Without these, the price check uses Claude's estimate.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Google Safe Browsing (free key: Google Cloud console → Safe Browsing API):
# known phishing links in chats. Without it, the link check uses look-alikes
# and domain age only.
GOOGLE_SAFE_BROWSING_KEY=

# Salt for hashing anonymous reporter ids. Set a random value in production.
# REPORTER_SALT=

# PORT=8787
