# Copy to server/.env and fill in. Everything is optional: without keys the
# server still scores listings with rules only.

# Claude: item identification, price estimate, red flags, one-line explanation.
ANTHROPIC_API_KEY=

# eBay Browse API (free keys at developer.ebay.com): live price comparisons.
# Without these, the price check uses Claude's estimate.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Google Safe Browsing (free key: Google Cloud console → Safe Browsing API):
# known phishing links in chats. Without it, the link check uses look-alikes
# and domain age only.
GOOGLE_SAFE_BROWSING_KEY=

# Google Cloud Vision (Web Detection): reverse image search for listing photos,
# to find the same photo in other sellers' listings. 1,000 free lookups a month.
# Listing photos are sent to Google. Without it, photos are only compared with
# listings checked through DealDig.
GOOGLE_VISION_API_KEY=

# Optional AI-image detector (sightengine.com, "genai" model). Only shown to the
# user as a notice; it never changes the score.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# The web search for copied descriptions uses Claude's web search tool (billed
# per search). Set to "off" to turn it off.
# DEALDIG_WEB_TEXT_SEARCH=off

# Salt for hashing anonymous reporter ids. Set a random value in production.
# REPORTER_SALT=

# PORT=8787
